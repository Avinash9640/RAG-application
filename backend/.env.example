DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:9640/rag_assistant

# local-hash-v1 has a fixed, intentional output size of 384.
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSION=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=45
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.08

# Optional OpenAI-compatible chat-completions endpoint. Without these values,
# the application returns grounded extractive answers with citations.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
